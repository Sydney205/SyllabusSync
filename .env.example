# Copy this file to .env and fill in the values. Never commit .env.

# ---------- Google Calendar ----------
# The calendar's ID: Google Calendar > Settings > (your calendar) > Integrate calendar > Calendar ID
CALENDAR_ID=your_calendar_id@group.calendar.google.com
DEFAULT_TIMEZONE=Africa/Lagos
# Used when an announcement has a start time but no end time/duration
DEFAULT_DURATION_MINUTES=60

# Option A (cloud hosts): the full service-account key JSON on ONE line
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}
# Option B (local): leave GOOGLE_CREDENTIALS_JSON unset and put the key file at ./service_account.json
# GOOGLE_CREDENTIALS_FILE=service_account.json

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Comma-separated numeric user IDs allowed to create events (send /whoami to the bot to find yours)
ADMIN_USER_IDS=123456789,987654321

# true  = long polling (easiest for local testing, no public URL needed)
# false = webhook mode (for Render/Railway)
RUN_POLLING=true
# Safety check: polling refuses to start if this token already has a webhook (i.e. your
# deployed bot is using it), because polling would take its messages away.
# Best fix: use a separate test bot token locally. Set true only to take over on purpose.
FORCE_POLLING=false

# Quiet mode: true = the bot still syncs Live classes but never posts in group chats
# (private chats still get replies). This is the starting value; flip it any time from
# the web UI (/admin sidebar) or with /quiet on | /quiet off. Runtime changes are saved
# to BOT_STATE_FILE; on hosts with a temporary disk they reset to this value on restart.
BOT_QUIET_MODE=false
# BOT_STATE_FILE=bot_state.json

# Webhook mode only:
# Public https URL of your deployment (no trailing slash). On Render this is detected automatically.
PUBLIC_BASE_URL=
# Random string, letters/digits/_/- only, 1-256 chars. Telegram sends it back in a header.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---------- Web UI ----------
# If set, GET / and POST /events require this passcode
WEB_UI_PASSWORD=choose-a-strong-passcode
